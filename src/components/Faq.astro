---
/**
 * FAQ, as native <details>/<summary> disclosure.
 *
 * No JavaScript and no ARIA authoring: the platform already gives correct
 * expand/collapse semantics, keyboard operation and screen-reader
 * announcement here. An accordion built from divs and click handlers would be
 * strictly worse.
 *
 * Renders from src/data/faq.ts, which also feeds the FAQPage JSON-LD, so the
 * two are guaranteed to match.
 */
import { faq } from '../data/faq';
---

<div class="faq">
  <!-- PLACEHOLDER — answers are stand-in copy; topics and structure are final. -->
  {
    faq.map((item) => (
      <details class="faq__item">
        <summary class="faq__q">{item.q}</summary>
        <div class="faq__a">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>
