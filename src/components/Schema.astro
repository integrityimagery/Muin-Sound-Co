---
/**
 * JSON-LD structured data.
 *
 * Every value here is read from src/data/*, which is the same source the
 * visible page renders from. That is the whole point: structured data cannot
 * claim something the page does not say, because there is only one copy of
 * each fact.
 *
 * Placeholder values stay clearly placeholder. Notably, package prices are
 * emitted WITHOUT a numeric `price` while `priceValue` is null — publishing an
 * invented number as structured data would be publishing a false claim.
 */
import { site } from '../data/site';
import { packages, CURRENCY } from '../data/packages';
import { faq } from '../data/faq';
import { themes, DEFAULT_THEME, type Theme } from '../data/themes';
import { withBase } from '../lib/paths';

interface Props {
  /** Emit Service + Offer entries (homepage and /packages). */
  service?: boolean;
  /** Emit FAQPage (anywhere the FAQ section appears). */
  includeFaq?: boolean;
  theme?: Theme;
}

const { service = false, includeFaq = false, theme = DEFAULT_THEME } = Astro.props;

/* Astro.site is the real deploy origin (set per environment by the build).
   site.url is only the fallback for a local build with no site configured —
   using it unconditionally would publish structured data pointing at a domain
   this deployment is not served from. */
const origin = (Astro.site?.href ?? site.url).replace(/\/$/, '');

/* Hand-written paths need the base applied before they are made absolute, or
   they resolve to the domain root and describe pages that do not exist there.
   withBase is idempotent, so paths Astro has already rewritten (imported image
   `.src` values) pass through unchanged. */
const abs = (path: string) => new URL(withBase(path), `${origin}/`).href;

/** The site's own root, base included. Used for @id and Organization.url. */
const siteRoot = abs('/');
const logoUrl = abs(themes[theme].lockup.src);

const organization = {
  '@type': 'Organization',
  '@id': `${siteRoot}#organization`,
  name: site.name,
  url: siteRoot,
  description: site.tagline,
  logo: {
    '@type': 'ImageObject',
    url: logoUrl,
    width: themes[theme].lockup.width,
    height: themes[theme].lockup.height,
  },
  email: site.email,
  sameAs: site.social.map((s) => s.href),
};

const serviceNode = {
  '@type': 'Service',
  '@id': `${siteRoot}#service`,
  name: 'Custom wedding song writing and production',
  serviceType: 'Custom wedding song',
  description: site.tagline,
  provider: { '@id': `${siteRoot}#organization` },
  // Remote-first: the area served is not geographic.
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Worldwide (remote)',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Packages',
    itemListElement: packages.map((p) => ({
      '@type': 'Offer',
      name: p.name,
      description: p.summary,
      url: abs(`/packages/#${p.slug}`),
      ...(p.priceValue === null
        ? {}
        : {
            priceSpecification: {
              '@type': 'PriceSpecification',
              price: p.priceValue,
              priceCurrency: CURRENCY,
              minPrice: p.priceValue,
            },
          }),
    })),
  },
};

const faqNode = {
  '@type': 'FAQPage',
  '@id': `${siteRoot}#faq`,
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const graph: object[] = [organization];
if (service) graph.push(serviceNode);
if (includeFaq) graph.push(faqNode);

const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })
  // Prevent a literal </script> inside any string from closing the block.
  .replace(/</g, '\\u003c');
---

<script type="application/ld+json" set:html={json} is:inline />
