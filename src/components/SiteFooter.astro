---
/**
 * Site footer. Identical on all four layouts.
 *
 * Uses the flat wordmark rather than the arched lockup, per brand direction —
 * the arch is a hero device and loses its force if it appears twice per page.
 */
import Brandmark from './Brandmark.astro';
import { site, nav, muinMeaning } from '../data/site';
import { withBase } from '../lib/paths';
import { DEFAULT_THEME, type Theme } from '../data/themes';

interface Props {
  theme?: Theme;
}

const { theme = DEFAULT_THEME } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <div class="site-footer__grid">
      <div>
        <Brandmark theme={theme} variant="wordmark" />
        <p style="margin-block-start: 1rem; font-size: var(--step--1); color: var(--muted);">
          {muinMeaning}
        </p>
      </div>

      <div>
        <h2>Where we work</h2>
        <!-- PLACEHOLDER -->
        <p style="font-size: var(--step--1); color: var(--muted);">
          {site.serviceArea}
        </p>
      </div>

      <div>
        <h2>Get in touch</h2>
        <ul>
          <!-- PLACEHOLDER — replace with the real address. -->
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={withBase("/start/")}>Start a conversation</a></li>
        </ul>
      </div>

      <div>
        <h2>Elsewhere</h2>
        <ul>
          <!-- PLACEHOLDER — replace or remove; these also become sameAs in JSON-LD. -->
          {
            site.social.map((s) => (
              <li>
                <a href={s.href} rel="me noopener">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2>Pages</h2>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={withBase(item.href)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="site-footer__legal">
      {/* site.name already ends in a full stop — no second one. */}
      <p>&copy; {site.founded}–{year} {site.name} All rights reserved.</p>
      <p>{site.tagline}</p>
    </div>
  </div>
</footer>
