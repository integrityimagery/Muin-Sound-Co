---
/**
 * Site header.
 *
 * Two presentations of the same markup:
 *   full    — centred lockup with the nav beneath. Home, Base, Listen.
 *   compact — smaller wordmark, nav inline and de-emphasised. Story pages,
 *             so the hero lands first.
 *
 * The nav is identical in both. On story pages it is toned down visually; it
 * is never removed, never hidden behind a desktop hamburger, and stays fully
 * keyboard reachable.
 *
 * FIXED, not sticky, with a spacer holding its expanded height. A sticky
 * header is still in the document flow, so shrinking it on scroll pulls every
 * following element up by the difference — a ~230px lurch mid-scroll, which no
 * amount of easing disguises. Out of flow with a constant-height spacer, the
 * collapse moves nothing but the header itself.
 */
import Brandmark from './Brandmark.astro';
import Nav from './Nav.astro';
import { DEFAULT_THEME, type Theme } from '../data/themes';

interface Props {
  variant?: 'full' | 'compact';
  theme?: Theme;
  pathname: string;
  /** On the homepage the lockup is the hero mark, not a link to itself. */
  markIsLink?: boolean;
}

const {
  variant = 'full',
  theme = DEFAULT_THEME,
  pathname,
  markIsLink = true,
} = Astro.props;
---

{/* Reserves the expanded header's height. Its height is set by script from a
    real measurement, because the header is fluid and content-sized. */}
<div class="header-spacer" data-header-spacer aria-hidden="true"></div>

{/* Layout-neutral tripwire at the document top: the header collapses once
    this has scrolled out of view. */}
<div class="header-sentinel" aria-hidden="true" data-header-sentinel></div>

<header
  class={`site-header site-header--${variant}`}
  data-header
  data-stuck="false"
>
  <div class="site-header__inner shell">
    <div class="site-header__brand">
      <Brandmark
        theme={theme}
        variant={variant === 'full' ? 'lockup' : 'wordmark'}
        asLink={markIsLink}
        collapsible={variant === 'full'}
      />
    </div>
    <Nav pathname={pathname} />
  </div>
</header>

<script>
  /**
   * Collapses the header once the page has scrolled past the sentinel, and
   * keeps the spacer matched to the header's expanded height.
   *
   * `position: fixed` is applied by script (via data-fixed) rather than in the
   * stylesheet, because without JS nothing would collapse it and nothing would
   * size the spacer — a full-height header pinned to the top of a phone is
   * worse than one that simply scrolls away. No script, no fixed header.
   *
   * An IntersectionObserver rather than a scroll listener: no per-frame work.
   */
  const header = document.querySelector<HTMLElement>('[data-header]');
  const spacer = document.querySelector<HTMLElement>('[data-header-spacer]');
  const sentinel = document.querySelector<HTMLElement>('[data-header-sentinel]');

  if (header && spacer && sentinel && 'IntersectionObserver' in window) {
    header.dataset.fixed = 'on';

    /* The spacer must hold the EXPANDED height, which can only be measured
       while the header is actually expanded. Cache it, and refresh whenever
       the header is expanded and changes size (fonts loading, resize, the nav
       rewrapping). While collapsed the cached value stands. */
    let expandedHeight = 0;

    /* Measuring at the wrong moment is worse than not measuring: a height
       captured mid-collapse writes a too-small spacer and the page shifts,
       which is the very thing the spacer exists to prevent. Two guards:

       1. Scroll position, not the data attribute. A ResizeObserver callback
          can land before the IntersectionObserver has flipped `stuck`, so the
          flag is not yet trustworthy during a collapse; the scroll offset
          always is.
       2. No running animation. A transition in flight means the height on
          screen is somewhere between the two states. */
    const isCollapsing = () => window.scrollY > sentinel.offsetHeight;
    /* `{ subtree: true }` matters: the header's own padding transition can
       finish while the mark inside is still resizing, and the header's height
       depends on that mark. Without it the measurement lands mid-flight and
       the spacer ends up a few pixels wrong — which is a visible content
       shift, intermittently. */
    const isAnimating = () =>
      header.getAnimations({ subtree: true }).some((a) => a.playState === 'running');

    const syncSpacer = () => {
      if (isCollapsing() || isAnimating()) return;
      const h = header.getBoundingClientRect().height;
      if (h > 0 && Math.abs(h - expandedHeight) > 0.5) {
        expandedHeight = h;
        spacer.style.height = `${h}px`;
      }
    };

    syncSpacer();
    new ResizeObserver(syncSpacer).observe(header);
    // Web fonts change the nav's height after first paint.
    document.fonts?.ready.then(syncSpacer);

    new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        header.dataset.stuck = String(!entry.isIntersecting);
        // Re-measure on the way back up, once the expansion has finished.
        if (entry.isIntersecting) {
          header.addEventListener('transitionend', syncSpacer, { once: true });
        }
      },
      { threshold: 0 }
    ).observe(sentinel);
  }
</script>
