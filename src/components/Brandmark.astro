---
/**
 * The logo.
 *
 * Picks the artwork variant matching the active theme. This is selection
 * between supplied files, never recolouring: each set is drawn for its own
 * ground and is illegible on the others.
 */
import { Image } from 'astro:assets';
import { themes, DEFAULT_THEME, type Theme } from '../data/themes';
import { site } from '../data/site';
import { withBase } from '../lib/paths';

interface Props {
  theme?: Theme;
  /** `lockup` is the full arched panel; `wordmark` is the flat lettering. */
  variant?: 'lockup' | 'wordmark';
  /** True on the homepage, where the mark is the h1's companion, not a link. */
  asLink?: boolean;
  class?: string;
}

const {
  theme = DEFAULT_THEME,
  variant = 'lockup',
  asLink = true,
  class: className = '',
} = Astro.props;

const asset = themes[theme][variant];

// The mark IS the business name, so that is its alt text. When it links home
// the link needs no additional label — the alt text serves as both.
const alt = site.name;

const widths = variant === 'lockup' ? [280, 420, 640] : [180, 280, 420];
const sizes =
  variant === 'lockup'
    ? '(max-width: 40rem) 13rem, 21rem'
    : '(max-width: 40rem) 8rem, 11.5rem';
---

{
  asLink ? (
    <a href={withBase("/")} class={`brandmark brandmark--${variant} ${className}`}>
      <Image src={asset} alt={alt} widths={widths} sizes={sizes} loading="eager" />
    </a>
  ) : (
    <span class={`brandmark brandmark--${variant} ${className}`}>
      <Image src={asset} alt={alt} widths={widths} sizes={sizes} loading="eager" />
    </span>
  )
}
