---
/**
 * The vine spine — the site's signature element.
 *
 * Two strands, not one. The logo draws two vines that cross over each other
 * above the wordmark, and Muin is the Ogham letter for vine: growth through
 * intertwining. So the page's spine is the same two strands, crossing roughly
 * once per section for the whole length of the page.
 *
 * Three things move as you scroll, and together they read as growth rather
 * than as a reveal:
 *
 *   1. The strands draw on.
 *   2. A tip leads the draw — the growing point, following the curve.
 *   3. Sprouts unfurl along the stem behind it, once the tip has passed.
 *
 * Geometry notes:
 *  - preserveAspectRatio="none" lets one path stretch to any page height.
 *  - vector-effect="non-scaling-stroke" keeps the stroke an even weight
 *    despite that stretch, which is what makes the trick invisible.
 *  - pathLength="1" normalises the draw-on animation so it does not depend on
 *    the rendered geometry.
 *
 * The tip and the sprouts are HTML, positioned in percentages, NOT inside the
 * stretched SVG — anything with a recognisable shape put in there would be
 * squashed along with it. Their coordinates are sampled from the real cubics
 * below, so they sit on the curve rather than near it.
 */

/** Three per 200-unit segment, sampled at t = 0.24 / 0.5 / 0.76 — the flanks
 *  and the crown of each bulge, where a real vine would branch. Angles fan
 *  from steep at the top of a bulge to flat at the bottom, so a run of leaves
 *  reads as one growing shoot rather than as repeated stamps. */
const sprouts = [
  { top: 3.6, left: 29.48, flip: -1, rot: -62, s: 0.86 },
  { top: 8.33, left: 21.88, flip: -1, rot: -40, s: 1.08 },
  { top: 13.06, left: 29.48, flip: -1, rot: -20, s: 0.94 },
  { top: 20.27, left: 70.52, flip: 1, rot: -56, s: 0.92 },
  { top: 25.0, left: 78.13, flip: 1, rot: -34, s: 1.14 },
  { top: 29.73, left: 70.52, flip: 1, rot: -14, s: 1.0 },
  { top: 36.94, left: 29.48, flip: -1, rot: -50, s: 0.86 },
  { top: 41.67, left: 21.88, flip: -1, rot: -28, s: 1.08 },
  { top: 46.4, left: 29.48, flip: -1, rot: -8, s: 0.94 },
  { top: 53.6, left: 70.52, flip: 1, rot: -62, s: 0.92 },
  { top: 58.33, left: 78.13, flip: 1, rot: -40, s: 1.14 },
  { top: 63.06, left: 70.52, flip: 1, rot: -20, s: 1.0 },
  { top: 70.27, left: 29.48, flip: -1, rot: -56, s: 0.86 },
  { top: 75.0, left: 21.88, flip: -1, rot: -34, s: 1.08 },
  { top: 79.73, left: 29.48, flip: -1, rot: -14, s: 0.94 },
  { top: 86.94, left: 70.52, flip: 1, rot: -50, s: 0.92 },
  { top: 91.67, left: 78.13, flip: 1, rot: -28, s: 1.14 },
  { top: 96.4, left: 70.52, flip: 1, rot: -8, s: 1.0 },
];
---

<div class="vine" aria-hidden="true">
  <svg
    class="vine__stem"
    viewBox="0 0 40 1200"
    preserveAspectRatio="none"
    focusable="false"
    role="presentation"
  >
    <path
      class="vine__path vine__path--a"
      pathLength="1"
      d="M 20 0
         C 5 50, 5 150, 20 200
         C 35 250, 35 350, 20 400
         C 5 450, 5 550, 20 600
         C 35 650, 35 750, 20 800
         C 5 850, 5 950, 20 1000
         C 35 1050, 35 1150, 20 1200"
    ></path>
    <path
      class="vine__path vine__path--b"
      pathLength="1"
      d="M 20 0
         C 35 50, 35 150, 20 200
         C 5 250, 5 350, 20 400
         C 35 450, 35 550, 20 600
         C 5 650, 5 750, 20 800
         C 35 850, 35 950, 20 1000
         C 5 1050, 5 1150, 20 1200"
    ></path>
  </svg>

  {
    sprouts.map((sprout) => (
      <span
        class="vine-sprout"
        style={`top:${sprout.top}%;left:${sprout.left}%;--flip:${sprout.flip};--rot:${sprout.rot}deg;--s:${sprout.s}`}
      >
        <svg class="vine-sprout__art" viewBox="0 0 30 22" focusable="false" role="presentation">
          <path class="vine-sprout__stalk" d="M 0 11 C 3 11, 6 11.4, 8.5 11" />
          <path
            class="vine-sprout__blade"
            d="M 8.5 11 C 14 3.6, 23 1.4, 29.5 3.4 C 24 9.6, 16 15.2, 8.5 11 Z"
          />
          <path class="vine-sprout__vein" d="M 9.5 11 C 16 8.4, 24 5.4, 29 3.6" />
        </svg>
      </span>
    ))
  }

  {/* The growing point. Leads the draw, so the vine reads as extending rather
      than as being uncovered. */}
  <span class="vine-tip">
    <svg viewBox="0 0 20 20" focusable="false" role="presentation">
      <path class="vine-tip__curl" d="M 10 19 C 10 13, 14 9, 13 6 C 12.4 4.2, 9.6 4.6, 9.8 6.6 C 10 8.4, 12.6 8.4, 13.4 6.8" />
      <circle class="vine-tip__bud" cx="10" cy="19" r="1.7" />
    </svg>
  </span>
</div>

<script>
  /**
   * Fallback for browsers without CSS scroll-driven animations.
   *
   * The vine is animated natively by `animation-timeline: scroll()/view()`,
   * which costs no JavaScript and no per-frame work — but that shipped in
   * Chrome 115, Firefox 144 and Safari 26. Older browsers got the graceful
   * degradation (vine drawn, every leaf open) and so saw no animation at all,
   * which is most of the point of the thing gone.
   *
   * This writes the values directly rather than driving the CSS keyframes.
   * The tip's position comes from `getPointAtLength` on the actual path, so it
   * needs no copy of the curve and is, if anything, more accurate than the
   * sampled keyframes the native path uses.
   *
   * The native rules are scoped with `:not([data-vine-fallback])` so the two
   * never run together: a scroll-driven animation on stroke-dashoffset would
   * otherwise win over an inline style and fight this.
   */
  const forced = new URLSearchParams(location.search).has('vine-fallback');
  const native = CSS.supports('animation-timeline', 'scroll()');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if ((forced || !native) && !still) {
    const vine = document.querySelector<HTMLElement>('.vine');
    const strands = [
      ...document.querySelectorAll<SVGPathElement>('.vine__path'),
    ];
    const tip = document.querySelector<HTMLElement>('.vine-tip');
    const lead = document.querySelector<SVGPathElement>('.vine__path--a');
    const sprouts = [
      ...document.querySelectorAll<HTMLElement>('.vine-sprout__art, .leaf-node'),
    ];

    if (vine && lead && tip) {
      document.documentElement.dataset.vineFallback = 'on';

      const clamp = (n: number) => (n < 0 ? 0 : n > 1 ? 1 : n);
      let queued = false;

      const paint = () => {
        queued = false;
        // Hidden below 560px; nothing to drive.
        if (!vine.offsetParent) return;

        const doc = document.documentElement;
        const max = doc.scrollHeight - window.innerHeight;
        const p = max > 0 ? clamp(window.scrollY / max) : 1;

        // Draw the strands. pathLength="1" makes these values geometry-free.
        strands.forEach((path, i) => {
          // The second strand trails, as it does natively.
          const q = clamp(i === 0 ? p : p - 0.03);
          path.style.strokeDasharray = '1';
          path.style.strokeDashoffset = String(1 - q);
        });

        // The growing point, taken from the real curve.
        const m = lead.getScreenCTM();
        if (m) {
          const pt = lead.getPointAtLength(p * lead.getTotalLength());
          const box = vine.getBoundingClientRect();
          tip.style.opacity = '1';
          tip.style.left = `${pt.x * m.a + m.e - box.left}px`;
          tip.style.top = `${pt.y * m.d + m.f - box.top}px`;
        }

        /* Sprouts open on their own position, mirroring the native `view()`
           range: each starts as it clears the bottom edge and finishes about a
           third of a viewport later. The shape is a plain ramp with the same
           slight overshoot as the keyframes. */
        const vh = window.innerHeight;
        for (const el of sprouts) {
          const sp = clamp((vh - el.getBoundingClientRect().top) / (vh * 0.38));

          if (el.classList.contains('leaf-node')) {
            // Matches @keyframes leaf-unfurl: 0.7 -> 1, -12deg -> 0.
            el.style.opacity = String(sp);
            el.style.transform = `scale(${(0.7 + 0.3 * sp).toFixed(3)}) rotate(${(-12 + 12 * sp).toFixed(2)}deg)`;
          } else {
            // Matches @keyframes vine-sprout, overshoot included.
            el.style.opacity = String(clamp(sp / 0.45));
            const grow =
              sp < 0.78
                ? 0.04 + (1.07 - 0.04) * (sp / 0.78)
                : 1.07 - 0.07 * ((sp - 0.78) / 0.22);
            el.style.setProperty('--grow', grow.toFixed(3));
          }
        }
      };

      const schedule = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(paint);
      };

      paint();
      addEventListener('scroll', schedule, { passive: true });
      addEventListener('resize', schedule, { passive: true });
    }
  }
</script>

<style>
  /* The second strand sits back so the pair reads as depth rather than as
     two equal lines. */
  .vine__path--b {
    stroke-width: 1;
    opacity: 0.5;
  }

  /* Trails the first strand slightly, so they appear to grow together
     rather than in lockstep. Only ever active inside the @supports +
     no-preference gate in global.css. */
  .vine__path--b {
    animation-range: 3% 100%;
  }
</style>
