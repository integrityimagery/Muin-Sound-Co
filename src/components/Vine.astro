---
/**
 * The vine spine — the site's signature element.
 *
 * Two strands, not one. The logo draws two vines that cross over each other
 * above the wordmark, and Muin is the Ogham letter for vine: growth through
 * intertwining. So the page's spine is the same two strands, crossing roughly
 * once per section for the whole length of the page.
 *
 * THE STEM IS ALWAYS THERE. Only the leaves grow.
 *
 * An earlier version drew the stem on as you scrolled, led by a travelling
 * growing point. It read well on the homepage and badly everywhere else: the
 * stem's length is the page's length, so any clock you tie it to either
 * measures the document (and then a short page arrives finished) or measures
 * the vine (and then the same scroll gesture grows different amounts on
 * different pages). Leaves have no such problem — each one is a fixed point in
 * the page, and "open when you reach it" means the same thing everywhere.
 *
 * Geometry notes:
 *  - preserveAspectRatio="none" lets one path stretch to any page height.
 *  - vector-effect="non-scaling-stroke" keeps the stroke an even weight
 *    despite that stretch, which is what makes the trick invisible.
 *
 * The leaves are HTML positioned in percentages, NOT children of the stretched
 * SVG — anything with a recognisable shape put in there would be squashed
 * along with it. Their coordinates are sampled from the real cubics below, so
 * they sit on the curve rather than near it.
 */

/* --- Growing the leaves ----------------------------------------------------

   Every leaf is generated: where it sits, which strand it grows from, which
   way it faces, how big it is, and its actual outline. Eighteen copies of one
   drawing at three angles looked stamped; no two of these are the same shape.

   Seeded, not `Math.random()`. The randomness is a design tool, so it should
   be a fixed one: the same vine ships from every build, is reviewable in a
   diff, and is stable enough to write tests against. Change SEED to deal a
   new hand. */

const SEED = 0x76696e65; // "vine"

/** mulberry32 — small, fast, good enough for scattering leaves. */
function rng(seed: number) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = rng(SEED);
/** Uniform in [lo, hi). */
const between = (lo: number, hi: number) => lo + rand() * (hi - lo);
const round = (n: number, dp = 2) => Number(n.toFixed(dp));

const cubic = (p0: number, p1: number, p2: number, p3: number, t: number) => {
  const u = 1 - t;
  return u * u * u * p0 + 3 * u * u * t * p1 + 3 * u * t * t * p2 + t * t * t * p3;
};

/* The stem is six 200-unit segments in a 40×1200 viewBox, alternating which
   side they bulge to. Strand B is strand A mirrored about the centre line,
   which is why they cross at every segment boundary. */
const SEGMENTS = 6;
const SEG_H = 200;
const VIEW_W = 40;
const VIEW_H = SEGMENTS * SEG_H;

/** A point on one strand: `strand` 0 is A, 1 is B. */
function onStem(segment: number, t: number, strand: 0 | 1) {
  const y0 = segment * SEG_H;
  const bulgeLeft = segment % 2 === 0;
  let cx = bulgeLeft ? 5 : 35;
  if (strand === 1) cx = VIEW_W - cx;
  return {
    x: cubic(20, cx, cx, 20, t),
    y: cubic(y0, y0 + 50, y0 + 150, y0 + SEG_H, t),
  };
}

/**
 * One leaf outline, drawn to order.
 *
 * Built along an axis rather than as a literal path so the parts stay in
 * register: the blade's two edges, the vein and the stalk are all expressed as
 * offsets from the same line, so a wider or more upswept leaf is still a leaf
 * and not a folded bag. Same vocabulary as the logo's foliage — pointed
 * almond blade, single vein, short stalk — just never twice the same.
 */
function leafShape() {
  const len = between(15, 20.5); // blade length, base to tip
  const wid = between(3.9, 6.6); // half-width at the widest point
  const lift = between(0.1, 0.4); // how far the tip swings up, as a fraction
  const stalk = between(4.5, 8);
  const belly = between(0.3, 0.46); // where along the blade it is widest

  const bx = stalk;
  const by = 11;
  const dx = len;
  const dy = -len * lift;
  const L = Math.hypot(dx, dy);
  const ux = dx / L;
  const uy = dy / L;
  // Perpendicular; negative offsets are the leaf's upper edge.
  const nx = -uy;
  const ny = ux;

  /** A point `u` along the blade axis, `v` to the side of it. */
  const at = (u: number, v: number) =>
    `${round(bx + ux * L * u + nx * v)} ${round(by + uy * L * u + ny * v)}`;

  const tip = at(1, 0);
  const blade =
    `M ${at(0, 0)} ` +
    `C ${at(belly * 0.55, -wid * 0.95)}, ${at(0.74, -wid * 0.58)}, ${tip} ` +
    `C ${at(0.68, wid * 0.52)}, ${at(belly, wid * 0.95)}, ${at(0, 0)} Z`;
  const vein =
    `M ${at(0.08, 0)} ` +
    `C ${at(0.4, -wid * 0.16)}, ${at(0.7, -wid * 0.12)}, ${at(0.92, -wid * 0.03)}`;
  const stem =
    `M 0 11 C ${round(stalk * 0.4)} 11, ${round(stalk * 0.72)} ${round(11 - len * lift * 0.2)}, ${at(0, 0)}`;

  return { blade, vein, stem };
}

type Leaf = {
  top: number;
  left: number;
  flip: -1 | 1;
  rot: number;
  s: number;
  dur: number;
  delay: number;
  shape: ReturnType<typeof leafShape>;
};

const leaves: Leaf[] = [];

for (let segment = 0; segment < SEGMENTS; segment++) {
  /* Three to five per segment. The same number in every segment is the thing
     that reads as decoration; an uneven one reads as a plant. */
  const count = 3 + Math.floor(rand() * 3);

  for (let k = 0; k < count; k++) {
    /* Evenly spaced slots, then jittered inside their own slot — keeps them
       from clumping or colliding while still landing at unequal intervals.
       Held away from the segment ends, where the strands cross and there is
       no outward side to grow towards. */
    const slot = (k + 0.5) / count;
    const t = Math.min(0.87, Math.max(0.13, slot + between(-0.34, 0.34) / count));
    const strand: 0 | 1 = rand() < 0.5 ? 0 : 1;
    const { x, y } = onStem(segment, t, strand);

    /* A leaf grows away from the stem, so its side is the curve's, not a
       coin toss — but with leaves on both strands, both sides are in play at
       every height. */
    const flip: -1 | 1 = x < 20 ? -1 : 1;

    /* Steep near the top of a bulge, flattening towards the bottom, the way a
       run of leaves on one shoot fans out. The jitter is what stops the fan
       from looking like a protractor. */
    const rot = -64 + 58 * t + between(-13, 13);

    leaves.push({
      top: round((y / VIEW_H) * 100, 3),
      left: round((x / VIEW_W) * 100, 3),
      flip,
      rot: round(rot, 1),
      s: round(between(0.8, 1.32), 3),
      // Bigger leaves take longer to open, with slack either way.
      dur: round(between(620, 1150)),
      delay: round(between(0, 240)),
      shape: leafShape(),
    });
  }
}
---

<div class="vine" aria-hidden="true">
  <svg
    class="vine__stem"
    viewBox="0 0 40 1200"
    preserveAspectRatio="none"
    focusable="false"
    role="presentation"
  >
    <path
      class="vine__path vine__path--a"
      d="M 20 0
         C 5 50, 5 150, 20 200
         C 35 250, 35 350, 20 400
         C 5 450, 5 550, 20 600
         C 35 650, 35 750, 20 800
         C 5 850, 5 950, 20 1000
         C 35 1050, 35 1150, 20 1200"
    ></path>
    <path
      class="vine__path vine__path--b"
      d="M 20 0
         C 35 50, 35 150, 20 200
         C 5 250, 5 350, 20 400
         C 35 450, 35 550, 20 600
         C 5 650, 5 750, 20 800
         C 35 850, 35 950, 20 1000
         C 5 1050, 5 1150, 20 1200"
    ></path>
  </svg>

  {
    leaves.map((leaf) => (
      <span
        class="vine-sprout"
        data-leaf
        style={`top:${leaf.top}%;left:${leaf.left}%;--flip:${leaf.flip};--rot:${leaf.rot}deg;--s:${leaf.s};--dur:${leaf.dur}ms;--delay:${leaf.delay}ms`}
      >
        <svg class="vine-sprout__art" viewBox="0 0 32 22" focusable="false" role="presentation">
          <path class="vine-sprout__stalk" d={leaf.shape.stem} />
          <path class="vine-sprout__blade" d={leaf.shape.blade} />
          <path class="vine-sprout__vein" d={leaf.shape.vein} />
        </svg>
      </span>
    ))
  }
</div>

<script>
  /**
   * Opens each leaf as you reach it.
   *
   * No scroll listener and no per-frame work, and — the point of the rewrite —
   * nothing that depends on how long the page is. A leaf opens once its top
   * has passed 82% of the viewport height, and then stays open; that sentence
   * is the whole behaviour, and it means the same thing on the homepage as on
   * a two-paragraph stub.
   *
   * An IntersectionObserver alone was not enough, which is worth recording
   * because it looks like it should be. With threshold 0, an entry is queued
   * only when `isIntersecting` CHANGES. Jump the viewport past a leaf in one
   * go — End, a fragment link, a flung trackpad, a test scrolling in
   * quarter-page steps — and it goes from below the root box to above it
   * without ever being inside one: no state change, no entry, no callback,
   * and a leaf you have scrolled well past sits there furled. On the homepage
   * that left 14 of 24 shut at the foot of the page.
   *
   * So the observer is the CUE and not the rule: every callback re-checks
   * every leaf still waiting, which catches the ones that were jumped over
   * along with the one that fired. The margin below and the line here are
   * deliberately the same number — the observer wakes at exactly the point
   * the rule cares about.
   *
   * `data-vine="grow"` is set by an inline script in Shell.astro, before first
   * paint, so the furled state is the first thing painted rather than a snap
   * back from the open one. Without JavaScript, or under
   * `prefers-reduced-motion`, the attribute is never set and the CSS leaves
   * every leaf open — a complete picture, just not an animated one.
   */
  const root = document.documentElement;

  /**
   * Arming waits for the layout to settle, and that is not belt-and-braces.
   *
   * The header is `position: fixed`, and its height is reserved by a spacer
   * that a script sizes from a real measurement. Until that happens the page
   * sits ~250px higher than it will end up. Arm before it and the leaves in
   * that band open for content the reader has not reached yet — and because
   * growth never runs backwards, they stay open. It showed up as two leaves
   * on /packages/ standing open below the fold, intermittently, depending on
   * whether the web fonts were cached.
   *
   * Fonts first (they change the header's height), then two frames: the
   * spacer's own font callback runs in the microtask checkpoint, so one frame
   * would already do, and the second is the cheap insurance.
   */
  const settled = (run: () => void) => {
    const fonts = document.fonts?.ready ?? Promise.resolve();
    fonts.then(() =>
      requestAnimationFrame(() => requestAnimationFrame(run))
    );
  };

  if (root.dataset.vine === 'grow') {
    const leaves = new Set(document.querySelectorAll<HTMLElement>('[data-leaf]'));

    if (!('IntersectionObserver' in window) || leaves.size === 0) {
      // No way to time the opening: show the finished vine, not a bare stem.
      delete root.dataset.vine;
    } else settled(() => {
      /** How far down the viewport a leaf must be before it opens. */
      const TRIGGER = 0.82;

      const observer = new IntersectionObserver(
        () => {
          const line = window.innerHeight * TRIGGER;
          for (const leaf of leaves) {
            if (leaf.getBoundingClientRect().top >= line) continue;
            leaf.classList.add('is-open');
            leaves.delete(leaf); // Growth does not run backwards.
            observer.unobserve(leaf);
          }
        },
        /* Bottom inset: a leaf opens once it is properly in the page rather
           than the instant it clips the bottom edge, so you watch it happen
           instead of finding it already done. */
        { rootMargin: `0px 0px -${Math.round((1 - TRIGGER) * 100)}% 0px`, threshold: 0 }
      );

      /* Spacing, not count, is what the eye reads — and the vine is as long as
         its page, so one fixed set of leaves is a thicket on a two-paragraph
         stub and a bare wire on the homepage. Thin it until no two leaves are
         closer than MIN_GAP, which makes the density a property of the design
         rather than of how much copy the page happens to carry.

         Section leaf-nodes are never thinned: they mark where a section
         starts, so their spacing is the page's to decide, not the vine's.

         Measured once. Re-thinning on resize would have leaves vanishing and
         reappearing as the window changed width, which is a far stranger
         thing to watch than a slightly uneven vine. */
      const MIN_GAP = 72;
      const height = document.querySelector('.vine')?.getBoundingClientRect().height ?? 0;
      let lastTop = -Infinity;

      for (const leaf of document.querySelectorAll<HTMLElement>('.vine-sprout')) {
        const top = (parseFloat(leaf.style.top) / 100) * height;
        if (top - lastTop >= MIN_GAP) {
          lastTop = top;
          continue;
        }
        leaf.hidden = true;
        leaves.delete(leaf);
      }

      for (const leaf of leaves) observer.observe(leaf);
    });
  }
</script>

<style>
  /* The second strand sits back so the pair reads as depth rather than as
     two equal lines. */
  .vine__path--b {
    stroke-width: 1;
    opacity: 0.5;
  }
</style>
