---
/**
 * Stand-in for photography that does not exist yet.
 *
 * Deliberately NOT a stock photo of an anonymous couple. This renders a
 * themed botanical panel at the correct aspect ratio with a visible
 * PLACEHOLDER label, so the layout can be judged honestly and nobody mistakes
 * it for real work. Pass `src` once real photography exists and this becomes
 * an ordinary <img>.
 */

interface Props {
  /** Real image path. When set, the placeholder art is not rendered. */
  src?: string;
  /** Required whenever `src` is set. */
  alt?: string;
  /** CSS aspect-ratio value, e.g. "16 / 9". */
  ratio?: string;
  /** Describes what the real photo should eventually be. */
  note?: string;
  class?: string;
}

const {
  src,
  alt,
  ratio = '16 / 9',
  note = 'Wedding photography',
  class: className = '',
} = Astro.props;

if (src && !alt) {
  throw new Error('PlaceholderFigure: `alt` is required when `src` is set.');
}
---

{
  src ? (
    <img src={src} alt={alt} class={className} style={`aspect-ratio: ${ratio}`} />
  ) : (
    <div
      class={`ph-figure ${className}`}
      style={`aspect-ratio: ${ratio}`}
      role="img"
      aria-label={`Placeholder for a photograph. ${note}.`}
    >
      <svg
        class="ph-figure__art"
        viewBox="0 0 320 180"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
        focusable="false"
      >
        <g fill="none" stroke="var(--vine-stem)" stroke-width="1.2" stroke-linecap="round">
          <path d="M -10 150 C 60 150, 90 90, 150 92 C 210 94, 250 40, 330 44" />
          <path d="M -10 168 C 70 168, 110 120, 170 124 C 230 128, 260 78, 330 82" />
        </g>
        <!-- Same pointed-leaf silhouette as LeafNode, so the placeholder reads
             as part of the drawing system rather than as stray ellipses. -->
        <defs>
          <path
            id="ph-leaf"
            d="M 0 -9 C 8 -3, 9.5 5, 0 14 C -9.5 5, -8 -3, 0 -9 Z"
          ></path>
        </defs>
        <g fill="var(--vine-leaf)" opacity="0.5">
          <use href="#ph-leaf" transform="translate(70 142) rotate(-118) scale(1.15)" />
          <use href="#ph-leaf" transform="translate(128 106) rotate(-104) scale(1.25)" />
          <use href="#ph-leaf" transform="translate(196 84) rotate(-124) scale(1.1)" />
          <use href="#ph-leaf" transform="translate(262 56) rotate(-112) scale(1)" />
          <use href="#ph-leaf" transform="translate(104 150) rotate(74) scale(0.95)" />
          <use href="#ph-leaf" transform="translate(228 112) rotate(66) scale(1.05)" />
        </g>
      </svg>
      <!-- PLACEHOLDER -->
      <p class="ph-figure__label">Placeholder image — {note}</p>
    </div>
  )
}
