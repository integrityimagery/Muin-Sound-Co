---
/**
 * Audio player.
 *
 * Progressive enhancement, deliberately. The HTML ships a real
 * <audio controls> element: fully keyboard operable, correctly labelled, and
 * working with zero JavaScript. Script replaces it with the custom UI only
 * after confirming it can. If the script never runs, the page still plays
 * music — which matters, because hearing a song within seconds of landing is
 * the entire differentiator of this site.
 *
 * Never autoplays.
 */

interface Props {
  src: string;
  /** Used to build accessible names: "Play {label}". */
  label: string;
  /** Shown above the controls. Omit to hide. */
  caption?: string;
  duration?: string;
  class?: string;
}

const { src, label, caption, duration, class: className = '' } = Astro.props;
---

<div class={`player ${className}`} data-player>
  {caption && <p class="player__title">{caption}</p>}

  <!-- The real media element. Visible and usable until JS hides it. -->
  <audio
    class="player__native"
    data-player-native
    controls
    preload="metadata"
    src={src}
  >
    <p>
      Your browser cannot play this audio.
      <a href={src} download>Download the track</a> instead.
    </p>
  </audio>

  <div class="player__row" data-player-ui hidden>
    <button type="button" class="player__button" data-player-play>
      <span data-player-icon-play>
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M3 1.5v13l11-6.5z"></path>
        </svg>
      </span>
      <span data-player-icon-pause hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M3 1.5h3.5v13H3zM9.5 1.5H13v13H9.5z"></path>
        </svg>
      </span>
      <span class="visually-hidden" data-player-button-label>Play {label}</span>
    </button>

    <input
      type="range"
      class="player__seek"
      data-player-seek
      min="0"
      max="100"
      step="0.1"
      value="0"
      aria-label={`Seek within ${label}`}
      aria-valuetext="0 seconds of 0 seconds"
    />

    <span class="player__time" data-player-time aria-hidden="true">
      0:00{duration ? ` / ${duration}` : ''}
    </span>
  </div>
</div>

<script>
  /**
   * Upgrades every <audio controls> on the page to the custom UI.
   *
   * The seek control is a native <input type="range">, so keyboard operation,
   * arrow-key stepping and screen-reader support come from the platform
   * rather than from hand-rolled key handling. It carries an aria-valuetext
   * in spoken units, because "37" is useless as a position announcement.
   */
  const spoken = (seconds: number) => {
    if (!Number.isFinite(seconds)) return '0 seconds';
    const total = Math.round(seconds);
    const m = Math.floor(total / 60);
    const s = total % 60;
    const parts: string[] = [];
    if (m > 0) parts.push(`${m} minute${m === 1 ? '' : 's'}`);
    parts.push(`${s} second${s === 1 ? '' : 's'}`);
    return parts.join(' ');
  };

  const clock = (seconds: number) => {
    if (!Number.isFinite(seconds)) return '0:00';
    const total = Math.floor(seconds);
    return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
  };

  const setup = (root: HTMLElement) => {
    const audio = root.querySelector<HTMLAudioElement>('[data-player-native]');
    const ui = root.querySelector<HTMLElement>('[data-player-ui]');
    const playBtn = root.querySelector<HTMLButtonElement>('[data-player-play]');
    const seek = root.querySelector<HTMLInputElement>('[data-player-seek]');
    const time = root.querySelector<HTMLElement>('[data-player-time]');
    const btnLabel = root.querySelector<HTMLElement>('[data-player-button-label]');
    const iconPlay = root.querySelector<HTMLElement>('[data-player-icon-play]');
    const iconPause = root.querySelector<HTMLElement>('[data-player-icon-pause]');

    if (!audio || !ui || !playBtn || !seek || !time || !btnLabel) return;

    // Only now is it safe to take the native controls away.
    audio.removeAttribute('controls');
    audio.classList.add('player__native--enhanced');
    ui.hidden = false;

    const name = btnLabel.textContent?.replace(/^Play\s+/, '') ?? 'track';
    let scrubbing = false;

    const paint = () => {
      const { currentTime, duration } = audio;
      if (!scrubbing && Number.isFinite(duration) && duration > 0) {
        seek.value = String((currentTime / duration) * 100);
      }
      seek.setAttribute(
        'aria-valuetext',
        `${spoken(currentTime)} of ${spoken(duration)}`
      );
      time.textContent = `${clock(currentTime)}${
        Number.isFinite(duration) ? ` / ${clock(duration)}` : ''
      }`;
    };

    const paintPlayState = () => {
      const playing = !audio.paused && !audio.ended;
      btnLabel.textContent = `${playing ? 'Pause' : 'Play'} ${name}`;
      iconPlay?.toggleAttribute('hidden', playing);
      iconPause?.toggleAttribute('hidden', !playing);
    };

    playBtn.addEventListener('click', () => {
      if (audio.paused) {
        // One song at a time; two overlapping tracks help nobody.
        document.querySelectorAll('audio').forEach((other) => {
          if (other !== audio) other.pause();
        });
        void audio.play();
      } else {
        audio.pause();
      }
    });

    seek.addEventListener('input', () => {
      scrubbing = true;
      if (Number.isFinite(audio.duration)) {
        audio.currentTime = (Number(seek.value) / 100) * audio.duration;
      }
    });
    seek.addEventListener('change', () => {
      scrubbing = false;
    });

    audio.addEventListener('timeupdate', paint);
    audio.addEventListener('loadedmetadata', paint);
    audio.addEventListener('durationchange', paint);
    audio.addEventListener('play', paintPlayState);
    audio.addEventListener('pause', paintPlayState);
    audio.addEventListener('ended', paintPlayState);

    paint();
    paintPlayState();
  };

  document.querySelectorAll<HTMLElement>('[data-player]').forEach(setup);
</script>
