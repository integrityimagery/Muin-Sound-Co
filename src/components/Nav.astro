---
/**
 * Main navigation.
 *
 * One <nav>, no duplicated markup — CSS switches the same links between an
 * inline bar (>=900px) and an off-canvas panel (<900px), so there is only ever
 * one set of them in the accessibility tree.
 *
 * The items are split into two lists so the wide layout can seat them either
 * side of the logo. It is a SPLIT and not a duplication: reading order is
 * still left group then right group, which is exactly the visual order, and
 * below 900px the two simply stack inside the off-canvas panel.
 *
 * Items with children follow the "disclosure navigation with top-level links"
 * pattern: a real link to the section, plus a SEPARATE small toggle button
 * beside it. Making the parent itself the toggle is the common shortcut and it
 * costs you the link — /stories/ is a real page and has to stay reachable,
 * including on touch, where there is no hover to reveal anything.
 *
 * Deliberately not role="menu"/menuitem: that maps to application menus and
 * asks for arrow-key semantics users do not expect from site navigation. A
 * list of links is what this is.
 */
import { nav, isCurrent, isCurrentSection } from '../data/site';
import { withBase } from '../lib/paths';

interface Props {
  /** Current pathname, for aria-current. */
  pathname: string;
}

const { pathname } = Astro.props;

/* Split down the middle. Deriving it rather than hard-coding three and three
   means adding a seventh item rebalances the header instead of quietly
   lopsiding it — and the CTA, which is always last, stays on the right. */
const split = Math.ceil(nav.length / 2);
const groups = [
  { side: 'start', items: nav.slice(0, split), offset: 0 },
  { side: 'end', items: nav.slice(split), offset: split },
];
---

<nav class="nav" aria-label="Main" data-nav data-open="false">
  <button
    type="button"
    class="nav__toggle"
    aria-expanded="false"
    aria-controls="main-nav-panel"
    data-nav-toggle
  >
    <span class="nav__toggle-bars" aria-hidden="true"></span>
    <span>Menu</span>
  </button>

  <div class="nav__panel" id="main-nav-panel" data-nav-panel>
    <button type="button" class="nav__close" data-nav-close>Close</button>
    {
      groups.map((group) => (
        <ul class={`nav__list nav__list--${group.side}`}>
          {group.items.map((item, n) => {
            /* Ids have to stay unique across the two lists, so they are keyed
               on the item's position in `nav`, not in its group. */
            const i = group.offset + n;
            const current = isCurrent(withBase(item.href), pathname);
            const inSection = isCurrentSection(withBase(item.href), pathname);
            const menuId = `nav-submenu-${i}`;

            return (
              <li class={item.children ? 'nav__item nav__item--has-menu' : 'nav__item'}>
                <a
                  href={withBase(item.href)}
                  class={item.primary ? 'btn btn--primary nav__cta' : 'nav__link'}
                  aria-current={current ? 'page' : inSection ? 'true' : undefined}
                >
                  {item.label}
                  {/* Not under the CTA: it is a filled button, and a vine
                      growing under a button reads as an underlined button. */}
                  {!item.primary && (current || inSection) && (
                    <svg
                      class="nav__vine"
                      viewBox="0 0 64 16"
                      aria-hidden="true"
                      focusable="false"
                    >
                      {/* Fixed size and centred rather than stretched to the
                          label. Stretching is what forced the previous version
                          to be a bare line: labels here run from LISTEN to FOR
                          PHOTOGRAPHERS, a 3x range, and leaves squashed by 3x
                          are not leaves. */}
                      <path
                        class="nav__vine-stem"
                        d="M 1 10 C 10 5.5, 18 13, 28 9.5 C 38 6, 47 13, 63 9"
                      />
                      <path
                        class="nav__vine-leaf"
                        d="M 15.5 8.6 C 12.18 8.71, 10.29 5.31, 9.5 2.2 C 12.55 3.19, 15.82 5.29, 15.5 8.6 Z"
                      />
                      <path
                        class="nav__vine-leaf"
                        d="M 30 9.2 C 28.7 6.3, 31.03 3.41, 33.5 1.6 C 33.73 4.65, 33.05 8.3, 30 9.2 Z"
                      />
                      <path
                        class="nav__vine-leaf"
                        d="M 45.5 8.7 C 45.61 5.29, 49.24 3.38, 52.5 2.6 C 51.28 5.72, 48.89 9.06, 45.5 8.7 Z"
                      />
                    </svg>
                  )}
                </a>

                {item.children && (
                  <>
                    <button
                      type="button"
                      class="nav__disclosure"
                      aria-expanded="false"
                      aria-controls={menuId}
                      data-nav-disclosure
                    >
                      {/* The button needs its own name — the adjacent link's
                          text is not it, and "expand" alone says nothing. */}
                      <span class="visually-hidden">{item.label} submenu</span>
                      <svg
                        class="nav__chevron"
                        viewBox="0 0 12 8"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <path
                          d="M1 1.5 L6 6.5 L11 1.5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </button>

                    <ul class="nav__submenu" id={menuId} data-nav-submenu hidden>
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={withBase(child.href)}
                            class="nav__sublink"
                            aria-current={
                              isCurrent(withBase(child.href), pathname) ? 'page' : undefined
                            }
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </li>
            );
          })}
        </ul>
      ))
    }
  </div>
</nav>

<script>
  /**
   * Off-canvas menu behaviour, plus the Stories disclosure.
   *
   * The off-canvas menu only exists below 900px; above that the same list is an
   * inline bar. Three things have to be true while it is open: focus cannot
   * leave it, Escape closes it, and the rest of the page is hidden from
   * assistive tech. `inert` does the third and most of the first; the explicit
   * Tab wrap is belt-and-braces for the panel's own edges.
   */
  const FOCUSABLE =
    'a[href], button:not([disabled]), input:not([disabled]), select, textarea, [tabindex]:not([tabindex="-1"])';

  /* ---------------------------------------------------------------------
     Submenu disclosures
     --------------------------------------------------------------------- */

  const setupDisclosures = (root: HTMLElement) => {
    const items = root.querySelectorAll<HTMLElement>('.nav__item--has-menu');

    // Hover-to-open is an enhancement for pointer devices on the wide layout
    // only. It drives the SAME open/close function as click, so aria-expanded
    // always reflects reality — a CSS-only :hover rule would leave the button
    // claiming to be collapsed while its menu is on screen.
    const canHover = window.matchMedia('(hover: hover) and (min-width: 900px)');

    /* Above this width the submenu is an absolutely-positioned dropdown; below
       it, an inline list inside the off-canvas panel. The two want different
       dismissal rules, so the layout breakpoint has to be readable here. */
    const isFloating = window.matchMedia('(min-width: 900px)');

    const all: { close: () => void; isOpen: () => boolean; focusButton: () => void }[] =
      [];

    items.forEach((item) => {
      const button = item.querySelector<HTMLButtonElement>('[data-nav-disclosure]');
      const menu = item.querySelector<HTMLElement>('[data-nav-submenu]');
      if (!button || !menu) return;

      let closeTimer: number | undefined;

      /**
       * Whether this menu is open only because the pointer is over it.
       *
       * Without this, hover and click fight each other: moving the mouse to the
       * chevron opens the menu, and the click that follows finds it already
       * open and closes it again — so with a mouse, clicking could never open
       * anything. Tracking the cause makes the two gestures compose instead:
       * hover opens it transiently, a click pins it, and only a hover-opened
       * menu closes itself when the pointer leaves.
       */
      let openedByHover = false;

      const setExpanded = (next: boolean) => {
        window.clearTimeout(closeTimer);
        button.setAttribute('aria-expanded', String(next));
        menu.hidden = !next;
        item.dataset.open = String(next);
        if (!next) openedByHover = false;
      };

      const close = () => setExpanded(false);
      const isOpen = () => button.getAttribute('aria-expanded') === 'true';

      all.push({ close, isOpen, focusButton: () => button.focus() });

      button.addEventListener('click', () => {
        if (isOpen()) {
          // Pin a hover-opened menu rather than immediately closing it.
          if (openedByHover) {
            openedByHover = false;
            return;
          }
          close();
          return;
        }
        all.forEach((d) => d.close()); // one open submenu at a time
        setExpanded(true);
      });

      item.addEventListener('mouseenter', () => {
        if (!canHover.matches) return;
        // Cancel any pending close FIRST, and unconditionally. Returning early
        // when the menu is already open would leave a close timer from the
        // previous mouseleave still running, so coming back to a menu you had
        // just left would close it under you a moment later.
        window.clearTimeout(closeTimer);
        if (isOpen()) return;
        all.forEach((d) => d.close());
        setExpanded(true);
        openedByHover = true;
      });

      item.addEventListener('mouseleave', () => {
        // A pinned menu stays until dismissed deliberately.
        if (!canHover.matches || !openedByHover) return;
        // Generous grace period: this menu is a column of six long titles, and
        // the trip down to it is neither short nor straight.
        closeTimer = window.setTimeout(close, 500);
      });

      // Tabbing out of the group closes it — but only where the submenu is a
      // floating dropdown. In the off-canvas panel it is an inline list, and
      // collapsing it the moment focus moves to the next item would undo the
      // expansion the user just asked for. focusout fires before the new
      // element is focused, hence relatedTarget.
      item.addEventListener('focusout', (e) => {
        if (!isFloating.matches) return;
        const next = (e as FocusEvent).relatedTarget as Node | null;
        if (next && item.contains(next)) return;
        close();
      });
    });

    // A click anywhere else dismisses an open submenu.
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.nav__item--has-menu')) return;
      all.forEach((d) => d.close());
    });

    // Leaving the hover breakpoint should not strand a menu opened by hover.
    canHover.addEventListener('change', () => all.forEach((d) => d.close()));

    return all;
  };

  /* ---------------------------------------------------------------------
     Off-canvas panel
     --------------------------------------------------------------------- */

  const setup = (root: HTMLElement) => {
    const disclosures = setupDisclosures(root);

    const toggle = root.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const panel = root.querySelector<HTMLElement>('[data-nav-panel]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-nav-close]');
    if (!toggle || !panel) return;

    // Everything that should be unreachable while the menu covers the page.
    const outside = () =>
      Array.from(
        document.querySelectorAll<HTMLElement>('main, .site-footer, .site-header__brand')
      );

    let open = false;

    const setOpen = (next: boolean) => {
      if (next === open) return;
      open = next;
      root.dataset.open = String(next);
      toggle.setAttribute('aria-expanded', String(next));
      document.documentElement.style.overflow = next ? 'hidden' : '';
      outside().forEach((el) => {
        if (next) el.setAttribute('inert', '');
        else el.removeAttribute('inert');
      });

      if (next) {
        panel.querySelector<HTMLElement>(FOCUSABLE)?.focus();
      } else {
        disclosures?.forEach((d) => d.close());
        toggle.focus();
      }
    };

    toggle.addEventListener('click', () => setOpen(!open));
    closeBtn?.addEventListener('click', () => setOpen(false));

    // Following a link unmounts the page anyway, but same-page hashes would
    // otherwise leave the menu covering the destination. The disclosure button
    // is not a link and must not close the panel.
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    /* Escape is handled in one place for the whole nav, at document level.
       Listening on the button and the submenu individually only works when
       focus happens to be on one of them — press Escape from any other link in
       the open panel and nothing happens at all. */
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        // An open submenu takes the first Escape, wherever focus is.
        const expanded = disclosures?.find((d) => d.isOpen());
        if (expanded) {
          e.preventDefault();
          const inside = (document.activeElement as HTMLElement | null)?.closest(
            '.nav__item--has-menu'
          );
          expanded.close();
          // Only pull focus back if it was inside the thing that just closed.
          if (inside) expanded.focusButton();
          return;
        }
        if (open) {
          e.preventDefault();
          setOpen(false);
        }
        return;
      }

      if (!open || e.key !== 'Tab') return;

      const items = Array.from(panel.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
        (el) => el.offsetParent !== null
      );
      if (items.length === 0) return;

      const first = items[0]!;
      const last = items[items.length - 1]!;

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Crossing the breakpoint while open would strand `inert` and a hidden
    // overflow on a page whose menu is now an ordinary inline bar.
    const desktop = window.matchMedia('(min-width: 900px)');
    desktop.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  };

  document.querySelectorAll<HTMLElement>('[data-nav]').forEach(setup);
</script>
