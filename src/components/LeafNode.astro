---
/**
 * A leaf marking the start of a section.
 *
 * Fixed size and never stretched, so the drawing stays a drawing: a pointed
 * blade with a centre vein and side veins, plus one tendril curl — the same
 * vocabulary as the logo's foliage, at the same level of detail. It used to
 * hang off a vine running down the page's left gutter; with that gone it is a
 * mark above the heading.
 *
 * Purely decorative. The section heading beside it carries the meaning, so
 * this is hidden from assistive tech.
 */

interface Props {
  /** Alternating tilt keeps a column of leaves from looking stamped. */
  flip?: boolean;
}

const { flip = false } = Astro.props;
const rotation = flip ? 24 : -24;
---

<span class="leaf-node" aria-hidden="true">
  <svg viewBox="0 0 44 44" focusable="false" role="presentation">
    <g transform={`rotate(${rotation} 22 22)`}>
      <!-- Blade -->
      <path
        class="leaf-blade"
        d="M 22 3
           C 35 12, 38 26, 22 41
           C 6 26, 9 12, 22 3 Z"
      ></path>
      <!-- Centre vein and side veins -->
      <path class="leaf-vein" d="M 22 6 L 22 39"></path>
      <path class="leaf-vein" d="M 22 14 L 30 18 M 22 14 L 14 18"></path>
      <path class="leaf-vein" d="M 22 23 L 32 28 M 22 23 L 12 28"></path>
      <path class="leaf-vein" d="M 22 31 L 28 35 M 22 31 L 16 35"></path>
    </g>
    <!-- Tendril curl, echoing the spirals at the ends of the logo's arch -->
    <path
      class="leaf-tendril"
      d="M 4 40 C 2 31, 9 26, 12 31 C 14 35, 8 37, 7 33"
    ></path>
  </svg>
</span>
