---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { nav } from '../data/site';
---

<Base
  title="Page not found"
  description="That page does not exist. Links to everywhere else on Muin Sound Co."
  heading="This path doesn’t go anywhere"
  eyebrow="404"
  lede="The page you were after has moved or never existed. Everything else is below."
>
  <Section class="section" leaf={false}>
    <ul class="stack" style="list-style: none; padding: 0;">
      {
        nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </Section>
</Base>
