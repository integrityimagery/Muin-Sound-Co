---
/**
 * Stub — the full page is coming.
 *
 * The three sample tracks are rendered so the Listen layout is actually
 * exercised (its wider content column exists precisely to hold these cards).
 * They reuse the same data as the homepage; no new content is invented here.
 */
import Listen from '../layouts/Listen.astro';
import Section from '../components/Section.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import { tracks } from '../data/tracks';
---

<Listen
  title="Listen"
  description="Sample recordings from Muin Sound Co. — ceremony songs, first dances and full-band celebration songs, with notes on style and instrumentation."
  heading="Listen"
  eyebrow="Samples"
  lede="A few examples of what these songs sound like, with a note on how each one is built."
>
  <Section class="section" leaf={false}>
    <!-- PLACEHOLDER — this page is coming; the full catalogue will live here. -->
    <p class="placeholder-note">Placeholder — the full listening page is coming</p>
  </Section>

  <Section class="section" eyebrow="Samples" heading="Three examples">
    <ul class="tracks">
      {
        tracks.map((track) => (
          <li class="track panel">
            <h3 class="track__title">{track.title}</h3>
            <p class="track__desc">{track.description}</p>
            <blockquote class="track__lyric">
              <p>{track.lyric}</p>
            </blockquote>
            <div class="track__player">
              <AudioPlayer
                src={track.src}
                label={track.title}
                duration={track.duration}
              />
            </div>
          </li>
        ))
      }
    </ul>
  </Section>
</Listen>
