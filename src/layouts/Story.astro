---
/**
 * Story layout — every /stories/* page.
 *
 * Exposes exactly four knobs (theme, hero, weight, song) and inherits
 * everything else. Each page should feel like a different room in the same
 * house, not a different house. The knob set is enforced by the zod schema in
 * src/content.config.ts, so adding a fifth is a deliberate act rather than
 * something that happens by accident on a Tuesday.
 *
 * Theming is a palette swap. It is not a licence to lower contrast: all three
 * palettes clear the same thresholds, verified by scripts/contrast-check.mjs.
 */
import Shell from './Shell.astro';
import Vine from '../components/Vine.astro';
import LeafNode from '../components/LeafNode.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import PlaceholderFigure from '../components/PlaceholderFigure.astro';
import type { Theme } from '../data/themes';
import type { StoryWeight } from '../data/stories';
import { withBase } from '../lib/paths';

export type StoryHero = 'photo' | 'type' | 'audio';

export type StorySong = {
  src: string;
  title: string;
  description?: string;
  lyric?: string;
};

interface Props {
  title: string;
  description: string;
  heading: string;
  eyebrow?: string;
  lede?: string;
  theme: Theme;
  hero: StoryHero;
  weight: StoryWeight;
  song?: StorySong;
  /** Photo hero only. */
  photo?: { src?: string; alt?: string; note?: string };
  /** Where the closing call to action points. */
  ctaHref?: string;
  ctaLabel?: string;
  ctaBody?: string;
}

const {
  title,
  description,
  heading,
  eyebrow,
  lede,
  theme,
  hero,
  weight,
  song,
  photo,
  ctaHref = '/start/',
  ctaLabel = 'Start here',
  ctaBody,
} = Astro.props;
---

<Shell
  title={title}
  description={description}
  theme={theme}
  weight={weight}
>
  <main id="main-content">
    <div class="shell">
      <div class="page-grid">
        <Vine />

        <div class={`section story-hero story-hero--${hero}`}>
          <LeafNode />
          <div class="section__head">
            {eyebrow && <span class="eyebrow">{eyebrow}</span>}
            <h1 class="story-hero__title">{heading}</h1>
            {lede && <p class="story-hero__lede">{lede}</p>}
          </div>

          {
            hero === 'photo' && (
              <PlaceholderFigure
                class="story-hero__figure"
                src={photo?.src}
                alt={photo?.alt}
                note={photo?.note ?? 'Ceremony photograph for this story'}
                ratio="16 / 9"
              />
            )
          }

          {
            hero === 'audio' && song && (
              <div class="story-hero__player">
                <AudioPlayer
                  src={song.src}
                  label={song.title}
                  caption="Listen"
                  />
              </div>
            )
          }
        </div>

        <slot />

        {
          /* On photo and type heroes the song still belongs on the page —
             just after the writing rather than ahead of it. */
          hero !== 'audio' && song && (
            <section class="section" aria-labelledby="story-song-heading">
              <LeafNode flip />
              <div class="section__head">
                <span class="eyebrow">The song</span>
                <h2 id="story-song-heading">{song.title}</h2>
              </div>
              {song.description && <p class="track__desc">{song.description}</p>}
              {song.lyric && (
                <blockquote class="track__lyric">
                  <p>{song.lyric}</p>
                </blockquote>
              )}
              <div class="track__player">
                <AudioPlayer src={song.src} label={song.title} />
              </div>
            </section>
          )
        }

        <div class="story-cta">
          <!-- PLACEHOLDER -->
          <p class="lede">
            {ctaBody ?? 'If this sounds like your wedding, the next step is a short form and one conversation.'}
          </p>
          <p class="actions">
            <a class="btn btn--primary" href={withBase(ctaHref)}>{ctaLabel}</a>
            <a class="btn btn--ghost" href={withBase("/stories/")}>Read another story</a>
          </p>
        </div>
      </div>
    </div>
  </main>
</Shell>
