---
/**
 * Listen layout — /listen.
 *
 * Same header and footer as Base; the difference is a wider content
 * column, because a track card carries a player, a prose description of the
 * instrumentation and a lyric excerpt, and all three need room to breathe.
 *
 * The extra width comes from two variables on the wrapper (--shell-max and
 * --measure), not from a competing set of layout rules.
 */
import Shell from './Shell.astro';
import LeafNode from '../components/LeafNode.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  eyebrow?: string;
  lede?: string;
}

const { title, description, heading, eyebrow, lede } = Astro.props;
---

<Shell title={title} description={description} bodyClass="layout-listen">
  <main id="main-content">
    <div class="shell">
      <div class="page-grid">
        <div class="section">
          <LeafNode />
          <div class="section__head">
            {eyebrow && <span class="eyebrow">{eyebrow}</span>}
            <h1>{heading}</h1>
            {lede && <p class="lede" style="margin-block-start: 1rem;">{lede}</p>}
          </div>
        </div>

        <slot />
      </div>
    </div>
  </main>
</Shell>
